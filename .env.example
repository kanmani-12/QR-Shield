# QRShield Environment Configuration
# Copy this file to .env and fill in your values
# Never commit the actual .env file to version control

# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Local MongoDB:  mongodb://localhost:27017/qrshield
# MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/qrshield
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/qrshield

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_64_BYTE_HEX_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_ANOTHER_STRONG_64_BYTE_HEX_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Threat Intelligence ───────────────────────────────────────────────────────
# Leave blank to run in demo mode (clearly labelled, never fabricates real results)

# Google Safe Browsing API (https://developers.google.com/safe-browsing/v4/get-started)
GOOGLE_SAFE_BROWSING_API_KEY=

# VirusTotal API (https://www.virustotal.com/gui/my-apikey)
VIRUSTOTAL_API_KEY=

# ── AI Explanations ───────────────────────────────────────────────────────────
# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Email Notifications (optional) ───────────────────────────────────────────
EMAIL_PROVIDER=none
# For Resend: EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=notifications@qrshield.example.com

# ── Security ──────────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
SCAN_RATE_LIMIT_MAX=20
COOKIE_SECRET=REPLACE_WITH_STRONG_COOKIE_SECRET

# ── Isolated Scanner ─────────────────────────────────────────────────────────
ISOLATED_SCANNER_ENABLED=false
SCANNER_REQUEST_TIMEOUT_MS=8000
SCANNER_MAX_REDIRECTS=5
SCANNER_MAX_RESPONSE_BYTES=1048576

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Automatically enabled when threat-intelligence keys are missing
# Set to true to force demo mode even with keys configured
FORCE_DEMO_MODE=false
